---
import MoonIcon from '@/components/atoms/icons/MoonIcon.astro';
import SunIcon from '@/components/atoms/icons/SunIcon.astro';
---

<button id="mode" class="btn btn-link" type="button" aria-label="Toggle user interface mode">
  <span class="toggle-dark">
    <MoonIcon />
  </span>
  <span class="toggle-light">
    <SunIcon />
  </span>
</button>

<script is:inline>
  (() => {
    const modeButton = document.getElementById('mode');
    if (!modeButton) return;

    // Override the existing click handler to dispatch a custom event
    modeButton.addEventListener('click', () => {
      // Wait for the theme change to complete
      setTimeout(() => {
        window.dispatchEvent(new Event('themeChanged'));
      }, 100);
    });
  })();
</script>

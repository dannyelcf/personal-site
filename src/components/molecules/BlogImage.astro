---
import ProgressiveImage from './ProgressiveImage.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  alt: string;
  title?: string;
  caption?: string;
  inline?: boolean;
  width?: string;
  height?: string;
  class?: string;
}

const { src, alt, title, caption, inline = false, width, height, class: className } = Astro.props;

// Get the current blog post slug from the URL
const url = Astro.url.pathname;
const match = url.match(/\/blog\/([^/]+)/);
const postSlug = match ? match[1] : '';

// Resolve the image
let resolvedImage: ImageMetadata | null = null;
let resolvedSrc: string | null = null;

if (src.startsWith('/')) {
  // Absolute path from public root
  resolvedSrc = src;
} else {
  // Relative path - use Vite's glob import to get all blog images
  const images = import.meta.glob<{ default: ImageMetadata }>(
    '/src/content/blog/**/*.{png,jpg,jpeg,gif,svg,webp}',
    { eager: true }
  );

  // Normalize the relative path by removing leading ./
  const normalizedSrc = src.startsWith('./') ? src.slice(2) : src;

  // Try with images/ subdirectory first
  let imagePath = `/src/content/blog/${postSlug}/images/${normalizedSrc}`;
  let imageModule = images[imagePath];

  // Fallback without images/ subdirectory
  if (!imageModule) {
    imagePath = `/src/content/blog/${postSlug}/${normalizedSrc}`;
    imageModule = images[imagePath];
  }

  if (imageModule && imageModule.default) {
    resolvedImage = imageModule.default;
  } else {
    console.warn(`Image not found: ${imagePath}`);
    resolvedSrc = src;
  }
}
---

{
  caption ? (
    <div class="picture-wrapper">
      <figure class="figure">
        {resolvedImage ? (
          <a href={resolvedImage.src}>
            <ProgressiveImage
              src={resolvedImage}
              alt={alt}
              class={`figure-img img-fluid ${className || ''}`}
              width={parseInt(width || String(resolvedImage.width))}
              height={parseInt(height || String(resolvedImage.height))}
            />
          </a>
        ) : (
          <a href={resolvedSrc}>
            <img
              src={resolvedSrc}
              alt={alt}
              title={title || alt}
              width={width}
              height={height}
              class={`figure-img img-fluid ${className || ''}`}
              loading="lazy"
            />
          </a>
        )}
        <figcaption class="figure-caption" set:html={caption} />
      </figure>
    </div>
  ) : resolvedImage && !inline ? (
    <ProgressiveImage
      src={resolvedImage}
      alt={alt}
      class={className || ''}
      width={parseInt(width || String(resolvedImage.width))}
      height={parseInt(height || String(resolvedImage.height))}
    />
  ) : resolvedImage && inline ? (
    <img
      src={resolvedImage.src}
      alt={alt}
      title={title}
      class={className}
      loading="lazy"
      style={`display: inline-block; position: relative; vertical-align: sub; top: 0.1rem;${width ? ` width: ${width};` : ''}`}
    />
  ) : (
    <img
      src={resolvedSrc}
      alt={alt}
      title={title}
      class={className}
      loading="lazy"
      style={
        inline
          ? `display: inline-block; position: relative; vertical-align: sub; top: 0.1rem;${width ? ` width: ${width};` : ''}`
          : undefined
      }
    />
  )
}

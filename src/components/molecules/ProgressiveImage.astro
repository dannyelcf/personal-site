---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
}

const { src, alt, class: className, width, height } = Astro.props;

// Generate images using getImage which works with Cloudflare
const placeholder = await getImage({
  src,
  width: 40,
  quality: 10,
  format: 'webp',
});

const w500 = await getImage({ src, width: 500, quality: 75, format: 'webp' });
const w600 = await getImage({ src, width: 600, quality: 75, format: 'webp' });
const w700 = await getImage({ src, width: 700, quality: 75, format: 'webp' });
const w800 = await getImage({ src, width: 800, quality: 75, format: 'webp' });
const w900 = await getImage({ src, width: 900, quality: 75, format: 'webp' });

const srcset = `${w900.src} 900w, ${w800.src} 800w, ${w700.src} 700w, ${w600.src} 600w, ${w500.src} 500w`;
---

<img
  class={`lazyload blur-up ${className || ''}`}
  src={placeholder.src}
  data-srcset={srcset}
  data-sizes="auto"
  width={width || src.width}
  height={height || src.height}
  alt={alt}
/>

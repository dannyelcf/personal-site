---
import GitHubIcon from '@/components/atoms/icons/GitHubIcon.astro';
import GitLabIcon from '@/components/atoms/icons/GitLabIcon.astro';
import LinkedInIcon from '@/components/atoms/icons/LinkedInIcon.astro';
---

<ul class="nav flex-column flex-lg-row">
  <li class="nav-item">
    <a class="nav-link social-link" href="https://github.com/dannyelcf" target="_blank">
      <GitHubIcon />
      <small class="d-lg-none ms-2 align-middle">GitHub</small>
    </a>
  </li>
  <li class="nav-item">
    <a class="nav-link social-link" href="https://gitlab.com/dannyelcf" target="_blank">
      <GitLabIcon />
      <small class="d-lg-none ms-2 align-middle">GitLab</small>
    </a>
  </li>
  <li class="nav-item">
    <a class="nav-link social-link" href="https://www.linkedin.com/in/dannyelcf/" target="_blank">
      <LinkedInIcon />
      <small class="d-lg-none ms-2 align-middle">LinkedIn</small>
    </a>
  </li>
</ul>

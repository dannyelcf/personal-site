---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// Build hierarchical TOC structure
interface TocItem {
  slug: string;
  text: string;
  children: TocItem[];
}

function buildToc(headings: MarkdownHeading[]): TocItem[] {
  const toc: TocItem[] = [];
  let currentH2: TocItem | null = null;

  headings.forEach((heading) => {
    if (heading.depth === 2) {
      currentH2 = { slug: heading.slug, text: heading.text, children: [] };
      toc.push(currentH2);
    } else if (heading.depth === 3 && currentH2) {
      currentH2.children.push({ slug: heading.slug, text: heading.text, children: [] });
    }
  });

  return toc;
}

const tocItems = buildToc(headings);
---

{
  tocItems.length > 0 && (
    <nav>
      <details open="">
        <summary>In this post</summary>
        <nav id="TableOfContents">
          <ul>
            {tocItems.map((item) => (
              <li>
                <a href={`#${item.slug}`}>{item.text}</a>
                {item.children.length > 0 && (
                  <ul>
                    {item.children.map((child) => (
                      <li>
                        <a href={`#${child.slug}`}>{child.text}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </nav>
  )
}

---
import ProgressiveImage from '@/components/molecules/ProgressiveImage.astro';
import { slugify } from '@/utils/slugify';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'> & { readingTime: number };
}

const { post } = Astro.props;
---

<div class="col">
  <div class="card">
    {
      post.data.cover && (
        <ProgressiveImage
          src={post.data.cover}
          alt={post.data.title}
          class="card-img-top img-fluid"
          width={1270}
          height={740}
        />
      )
    }
    <div class="card-body text-content">
      <article>
        <h2 class="h3">
          <a class="stretched-link text-body" href={`/blog/${post.slug}`}>
            {post.data.title}
          </a>
        </h2>
        <p>{post.data.excerpt || post.data.description}</p>
        <p>
          <small>
            Posted in{' '}
            {
              post.data.categories && post.data.categories.length > 0 && (
                <a
                  class="stretched-link position-relative link-muted"
                  href={`/categories/${slugify(post.data.categories[0])}/`}
                >
                  {post.data.categories[0]}
                </a>
              )
            }{' '}
            on{' '}
            {
              post.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })
            }{' '}
            by{' '}
            <a
              class="stretched-link position-relative"
              href={post.data.contributors && post.data.contributors.length > 0
                ? `/contributors/${slugify(post.data.contributors[0])}/`
                : '#'}
            >
              Dannyel Cardoso da Fonseca
            </a>{' '}
            ‐ <strong>{post.readingTime} min read</strong>
          </small>
        </p>
      </article>
    </div>
  </div>
</div>

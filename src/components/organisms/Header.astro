---
import Brand from '@/components/molecules/Brand.astro';
import Navigation from '@/components/organisms/Navigation.astro';
import MobileMenuButton from '@/components/molecules/MobileMenuButton.astro';
import OffcanvasMenu from '@/components/organisms/OffcanvasMenu.astro';
import DarkModeToggle from '@/components/molecules/DarkModeToggle.astro';

// Check if current page is a blog page
const isBlogPage = Astro.url.pathname.startsWith('/blog');
---

<div class="sticky-top">
  <div class="header-bar"></div>
  <header class="navbar navbar-expand-lg navbar-light doks-navbar">
    <nav class="container-xxl flex-lg-nowrap flex-wrap" aria-label="Main navigation">
      <Brand />

      <div class="ms-2 me-auto">
        <Navigation isBlogPage={isBlogPage} mobile={true} />
      </div>

      <MobileMenuButton />

      <OffcanvasMenu isBlogPage={isBlogPage} />

      <DarkModeToggle />
    </nav>
  </header>
</div>

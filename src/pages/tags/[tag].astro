---
import BlogListLayout from '@/layouts/BlogListLayout.astro';
import { getStaticPathsByField } from '@/utils/getStaticPathsHelper';

export async function getStaticPaths() {
  return getStaticPathsByField('tags', 'tag');
}

const { heading, posts } = Astro.props;
---

<BlogListLayout
  title={`${heading} - Dannyel Cardoso da Fonseca`}
  description={`Blog posts tagged with: ${heading}`}
  heading={heading}
  posts={posts}
/>
